DEBUG=False
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://user:password@host/dbname
ALLOWED_HOSTS=your-app-name.onrender.com,*.railway.app,localhost
SITE_URL=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
STATIC_ROOT=/var/www/vibemall_shared/staticfiles
MEDIA_ROOT=/var/www/vibemall_shared/media

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration
# For Brevo (Sendinblue) SMTP
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-login-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=VibeMall <your-verified-sender-email@example.com>

# Alternative: Gmail SMTP (if not using Brevo)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=VibeMall <your-email@gmail.com>

# Admin Notification Emails
# Comma-separated list of admin emails who should receive order notifications
ADMIN_NOTIFICATION_EMAILS=admin@vibemall.com,orders@vibemall.com
# Set to True to enable admin email notifications for new orders
ENABLE_ADMIN_ORDER_NOTIFICATIONS=True

# ==============================
# ENVIRONMENT VALIDATION
# ==============================
# On Django startup, the application validates environment variables:
# - CRITICAL: Must be set for app to function (errors will be logged)
# - IMPORTANT: Should be configured for production (warnings if missing)
# - OPTIONAL: Have sensible defaults (info logged if configured)
#
# Check Django logs for validation messages:
#   [CRITICAL] Missing required environment variables: ...
#   [WARNING] Missing important environment variables: ...
#   [INFO] Optional environment variables configured: ...
#
# Configuration guide: See ENV_CONFIGURATION.md

# ==============================
# TRADING BOT CONFIGURATION
# ==============================
BOT_API_URL=http://127.0.0.1:8001
BOT_API_KEY=change-this-bot-api-key

# ==============================
# n8n AI AUTOMATION
# ==============================
# Secret key for n8n product ingestion API
# Set a strong random string — n8n sends this as: Authorization: Bearer <key>
N8N_API_KEY=7755ca765dea87a061f8d12a919b51d9f7994dce07577efd5a965e4c59535d93

# ==============================
# TELEGRAM → AI PRODUCT AUTOMATION
# ==============================
# Bot token from @BotFather (t.me/BotFather -> /newbot, or /revoke to rotate).
# Treat this like a password: anyone holding it controls your bot.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated allow-list of chat/channel IDs the bot accepts
# products from. Leave empty to accept every chat the bot can see (dev only).
# Find an ID by messaging the bot and checking the draft's source_chat_id.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- AI provider -------------------------------------------------------
# 'auto' (default) uses whichever key is set, preferring Claude when both are.
# Set explicitly to 'gemini' or 'claude' to pin one.
AUTOMATION_AI_PROVIDER=auto

# Google Gemini - FREE tier, no credit card, includes vision.
# Get a key: https://aistudio.google.com/apikey  (sign in with any Google account)
GEMINI_API_KEY=
AUTOMATION_GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude - paid, highest quality.
# If neither key is set, the pipeline falls back to rule-based extraction only.
ANTHROPIC_API_KEY=

# Model and effort. 'medium' effort is a good cost/quality balance for
# catalogue work; raise to 'high' if descriptions need more polish.
AUTOMATION_AI_MODEL=claude-opus-5
AUTOMATION_AI_EFFORT=medium
AUTOMATION_AI_MAX_TOKENS=8000

# Seconds to wait after the last album part before parsing a multi-photo post.
AUTOMATION_ALBUM_SETTLE_SECONDS=10

# Retry budget per draft before it is marked FAILED.
AUTOMATION_MAX_ATTEMPTS=4
